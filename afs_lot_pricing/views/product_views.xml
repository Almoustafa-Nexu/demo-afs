<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_template_property_form_afs_lot_pricing" model="ir.ui.view">
        <field name="name">product.template.form.afs.lot.pricing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock_account.view_template_property_form_stock_account"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_valuated']" position="after">
                <field name="afs_lot_pricing" invisible="not lot_valuated"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_afs_lot" model="ir.ui.view">
        <field name="name">account.move.form.afs.lot</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="afs_lot_id" optional="show" readonly="1" column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_afs_lot_pricing" model="ir.ui.view">
        <field name="name">product.pricelist.form.afs.lot.pricing</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']" position="inside">
                <field name="afs_lot_pricing"/>
            </xpath>
        </field>
    </record>
</odoo>
