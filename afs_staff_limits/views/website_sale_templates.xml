<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Productpagina in de personeelsshop: onder "In winkelwagen" staat hoeveel er nog mag -->
    <template id="product_staff_limit" inherit_id="website_sale.cta_wrapper" name="Personeelslimiet op de productpagina">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <t t-set="afs_staff_limit" t-value="product and product._afs_staff_limit_info()"/>
            <div t-if="afs_staff_limit" class="alert alert-info py-2 small" role="status">
                <t t-if="afs_staff_limit['remaining']">
                    Je kan hiervan dit jaar nog <strong t-out="afs_staff_limit['remaining']"/> stuks bestellen
                    (maximum <t t-out="afs_staff_limit['limit']"/> per jaar).
                </t>
                <t t-else="">
                    Je kan hiervan dit jaar niets meer bestellen
                    (maximum <t t-out="afs_staff_limit['limit']"/> per jaar).
                </t>
            </div>
        </xpath>
    </template>

</odoo>