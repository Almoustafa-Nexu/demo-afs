<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="afs_purchase_vendor.AfsVendorDialog">
        <Dialog title="props.title" size="'lg'" contentClass="'o_error_dialog'">
            <div role="alert">
                <p t-esc="props.message" class="text-prewrap"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="accept">Accepteer</button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">Weigeren</button>
            </t>
        </Dialog>
    </t>
</templates>
