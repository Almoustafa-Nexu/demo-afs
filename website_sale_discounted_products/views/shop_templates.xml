<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Prijs met korting (shoplijst en blokken): -%, Voorheen, Nu en een teller.
         Variabelen: promo_old, promo_new, promo_end en promo_price_name (beide optioneel). -->
    <template id="promo_price" name="Prijs met korting">
        <div t-if="promo_old and promo_old &gt; promo_new" class="o_promo_price d-flex flex-column align-items-start lh-sm">
            <span class="badge text-bg-danger mb-1">-<t t-out="max(1, int(round(100 * (promo_old - promo_new) / promo_old)))"/>%</span>
            <span class="text-muted small">Voorheen
                <del style="white-space: nowrap;"><span t-out="promo_old"
                    t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/></del>
            </span>
            <span>
                <span class="small">Nu</span>
                <span class="mb-0 fw-bold" t-att-name="promo_price_name" t-out="promo_new"
                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
            </span>
            <t t-call="website_sale_discounted_products.promo_countdown"/>
        </div>
        <span t-else="" class="mb-0 fw-bold" t-att-name="promo_price_name" t-out="promo_new"
              t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
    </template>

    <!-- Live teller tot het einde van de actie (static/src/js/promo_countdown.js) -->
    <template id="promo_countdown" name="Teller tot het einde van de actie">
        <div t-if="promo_end"
             class="o_promo_countdown small text-danger mt-1"
             t-att-data-end="promo_end.strftime('%Y-%m-%dT%H:%M:%SZ')">
            <i class="fa fa-clock-o me-1" role="img" aria-label="Tijd"/>Nog <span class="o_promo_countdown_value fw-bold"/>
        </div>
    </template>

    <!-- Productraster zoals de shop, met de prijs met korting. Variabelen: grid_products, grid_id (optioneel). -->
    <template id="product_grid" name="Productraster">
        <t t-set="grid_col_width" t-value="12 // ppr"/>
        <t t-set="grid_col_md" t-value="hasLeftColumn and ('g-col-md-' + str(grid_col_width)) or (((not hasLeftColumn and ppr == 4) or (opt_wsale_fullwidth and ppr > 3)) and 'g-col-md-4') or 'g-col-md-6'"/>
        <!-- eigen prijzen: get_product_prices van de shop kent deze producten niet -->
        <t t-set="grid_price_map" t-value="grid_products._get_sales_prices(website)"/>
        <section
            t-att-id="grid_id"
            t-att-data-name="grid_id and grid_block_name"
            t-attf-class="o_wsale_products_grid_table grid {{hasLeftColumn and 'o_wsale_products_grid_table_md'}} {{website.shop_opt_products_design_classes}}"
            t-attf-style="--o-wsale-ppr: {{ppr}}; --o-wsale-ppg: {{ppg}}; --o-wsale-products-grid-gap: {{gap}};"
        >
            <t t-foreach="grid_products" t-as="product">
                <t t-set="template_price_vals" t-value="grid_price_map[product.id]"/>
                <t t-set="ribbon" t-value="product._get_ribbon(price_vals=template_price_vals, auto_assign_ribbons=auto_assign_ribbons, variant=product.product_variant_id)"/>
                <t t-set="product_variants" t-value="{**product_variants, product: product.product_variant_id}"/>
                <t t-set="previewed_attribute_values" t-value="{**previewed_attribute_values, product.id: {}}"/>
                <div t-attf-class="oe_product g-col-6 {{grid_col_md}} g-col-lg-{{grid_col_width}}"
                     style="--o-wsale-products-grid-product-col-height: 1;">
                    <div class="o_wsale_product_grid_wrapper position-relative h-100 o_wsale_product_grid_wrapper_1_1">
                        <t t-call="website_sale.products_item">
                            <t t-set="get_product_prices" t-value="lambda p: grid_price_map[p.id]"/>
                            <t t-set="product_price">
                                <div class="product_price" aria-label="Price information">
                                    <t t-call="website_sale_discounted_products.promo_price">
                                        <t t-set="promo_old" t-value="template_price_vals.get('base_price') or product.list_price"/>
                                        <t t-set="promo_new" t-value="template_price_vals['price_reduce']"/>
                                    </t>
                                </div>
                            </t>
                            <t t-set="design_field" t-value="website.shop_opt_products_design_classes"/>
                            <t t-set="product_href" t-value="product._get_product_url(category, product_query_params, grouped_attributes_values)"/>
                        </t>
                    </div>
                </div>
            </t>
        </section>
    </template>

    <!-- /shop. Hoofdpagina: blokken (afs_sections, controllers/shop.py) in plaats van de lijst en de pagina's.
         Met een categorie, zoekterm of filter: de lijst, met de producten in actie in een blok onderaan. -->
    <template id="promotions_block" inherit_id="website_sale.products">

        <xpath expr="//div[hasclass('o_wsale_products_grid_table_wrapper')]" position="before">
            <t t-set="promo_products" t-value="not afs_sections and not afs_is_promotions_page and request.env['product.template']._get_promo_products()"/>
            <div t-if="afs_sections" class="o_afs_shop_sections">
                <section t-foreach="afs_sections" t-as="afs_section"
                         class="o_afs_shop_section" t-att-id="afs_section['anchor']">
                    <h2 class="o_afs_shop_section_title" t-out="afs_section['title']"/>
                    <t t-if="afs_section['products']" t-call="website_sale_discounted_products.product_grid">
                        <t t-set="grid_products" t-value="afs_section['products']"/>
                        <t t-set="grid_id" t-value="afs_section.get('grid_id')"/>
                    </t>
                    <p t-else="" class="text-muted" t-out="afs_section.get('empty_text')"/>
                </section>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('o_wsale_products_grid_table_wrapper')]" position="attributes">
            <attribute name="t-if">products and not afs_sections</attribute>
        </xpath>

        <!-- "Geen producten" alleen als er ook geen promoties of blokken zijn -->
        <xpath expr="//div[hasclass('o_wsale_products_grid_table_wrapper')]/following-sibling::div[@t-else][1]" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-elif">not promo_products and not afs_sections</attribute>
        </xpath>

        <xpath expr="//div[@id='o_wsale_pager']" position="before">
            <div t-if="promo_products" class="mt-4 mb-4">
                <h1 class="fs-3 mt-5 mb-3" t-out="afs_promo_title or 'Promoties'"/>
                <t t-call="website_sale_discounted_products.product_grid">
                    <t t-set="grid_products" t-value="promo_products"/>
                </t>
            </div>
        </xpath>

        <xpath expr="//div[@id='o_wsale_pager']" position="attributes">
            <attribute name="t-if">not afs_sections</attribute>
        </xpath>

    </template>

    <!-- Categorietabs op de hoofdpagina springen naar het blok van de categorie -->
    <template id="filmstrip_section_anchors" inherit_id="website_sale.filmstrip_categories">
        <xpath expr="//a[hasclass('o_wsale_filmstrip_link')]" position="attributes">
            <attribute name="t-att-href">('#' + afs_section_anchors[c.id]) if afs_section_anchors and c.id in afs_section_anchors else keep('%s/category/%s' % (shop_path, slug(c)))</attribute>
        </xpath>
    </template>

    <!-- Productpagina bij een korting: Normale prijs, Actieprijs, Je bespaart en hoe lang de actie loopt.
         Niet bij producten met varianten. Oude prijs: die van Odoo, anders de verkoopprijs.
         Odoo's eigen prijs blijft staan (verborgen bij een korting), zodat een update van Odoo hier niets breekt. -->
    <template id="product_price_promo" inherit_id="website_sale.product_price">

        <xpath expr="//div[@name='product_price_container']" position="before">
            <t t-set="promo_old" t-value="max(combination_info['list_price'] or 0, product.list_price or 0)"/>
            <t t-set="promo_show" t-value="not product.has_configurable_attributes and promo_old &gt; combination_info['price']"/>
            <t t-set="promo_end" t-value="combination_info.get('discount_end_date')"/>
        </xpath>

        <!-- eerst Odoo's prijs verbergen bij een korting, dan de tabel ervoor zetten (met haar eigen oe_price) -->
        <xpath expr="//span[hasclass('oe_price')]" position="attributes">
            <attribute name="t-if">not promo_show</attribute>
        </xpath>
        <xpath expr="//span[@name='product_list_price']" position="attributes">
            <attribute name="t-if">not promo_show</attribute>
        </xpath>
        <xpath expr="//span[hasclass('oe_price')]" position="before">
            <div t-if="promo_show" class="o_promo_table">
                <span class="o_promo_label">Normale prijs</span>
                <span class="o_promo_old_price text-muted"
                      style="text-decoration: line-through; white-space: nowrap;"
                      t-out="promo_old"
                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span class="o_promo_label">Actieprijs</span>
                <span class="oe_price"
                      style="white-space: nowrap;"
                      t-out="combination_info['price']"
                      t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                <span class="o_promo_label">Je bespaart</span>
                <span class="o_promo_saving">
                    <span class="text-nowrap" t-out="promo_old - combination_info['price']"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    <span class="badge text-bg-danger o_promo_badge">−<t t-out="max(1, int(round(100 * (promo_old - combination_info['price']) / promo_old)))"/>%</span>
                </span>
            </div>
        </xpath>

        <xpath expr="//div[@name='product_price_container']" position="after">
            <div t-if="promo_show and promo_end"
                 class="o_promo_countdown o_promo_countdown_page small mt-2"
                 t-att-data-end="promo_end.strftime('%Y-%m-%dT%H:%M:%SZ')">
                <i class="fa fa-clock-o me-1" role="img" aria-label="Tijd"/>Actie loopt nog <span class="o_promo_countdown_value fw-bold"/>
            </div>
        </xpath>

    </template>

</odoo>
